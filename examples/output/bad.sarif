            "payment": null
          }
        },
        {
          "ruleId": "iban-checksum",
          "ruleIndex": 6,
          "level": "error",
          "message": {
            "text": "The iban of payment P-002, GR1601101250000000012300696, fails the check of ISO 13616: the remainder of MOD 97-10 is 28, not 1, so a character is wrong or two are swapped. A bank may return or reject the payment. Fix: Copy the IBAN again from the beneficiary, in electronic form or in groups of four; never correct the check digits by hand to make it pass."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/batch.json",
                  "index": 0
