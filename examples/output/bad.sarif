          "message": {
            "text": "The amount of payment P-009 is negative (-200.00); a payout pays out, and a reversal or a fee belongs in a file of its own. This is a best practice of this tool, not a rule in the pages it cites. Fix: Write the amount as a plain decimal number above 0, such as 1500.00, and move reversals and fees to a file of their own."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/batch.json",
