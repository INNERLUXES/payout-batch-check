          "message": {
            "text": "The amount of payment P-008 is 150000.50 JPY, with 1 decimal place, but the ISO 4217 list gives JPY a minor unit of 0: it has no fractions. A bank refuses the amount or rounds it. Fix: Round the amount to the minor unit of the currency before the batch is sent, and make sure the rounding is the one the beneficiary is owed."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/batch.json",
                  "index": 0
