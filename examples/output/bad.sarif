          "message": {
            "text": "The bic of payment P-005, \"EXMP GB2L\", has 9 characters, not 8 or 11. A BIC of ISO 9362 is four letters or digits, two letters of a country, two letters or digits, and an optional branch code of three. Fix: Copy the BIC again from the bank of the beneficiary, in capitals and with no spaces."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/batch.json",
                  "index": 0
                },
                "region": {
                  "startLine": 65,
