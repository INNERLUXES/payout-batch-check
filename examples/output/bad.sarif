        },
        {
          "ruleId": "iban-length",
          "ruleIndex": 7,
          "level": "error",
          "message": {
            "text": "The iban of payment P-003 has 17 characters, but the IBAN registry of Swift gives NL IBANs 18. Fix: Copy the IBAN again from the beneficiary; an IBAN of the right country always has the length of the registry."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/batch.json",
                  "index": 0
                },
                "region": {
                  "startLine": 45,
                  "startColumn": 7
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "payment": "P-003"
          }
        },
        {
