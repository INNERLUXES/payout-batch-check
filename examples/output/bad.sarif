                "region": {
                  "startLine": 186,
                  "startColumn": 7
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "payment": "P-017"
          }
        },
        {
          "ruleId": "secret-in-batch",
          "ruleIndex": 5,
          "level": "error",
          "message": {
            "text": "The batch holds the key \"seedPhrase\", which names a seed, a mnemonic or a private key. The tool never reads one, and the value is not shown. Fix: Remove the value from the file and from wherever the file was copied, treat it as exposed and move the funds it controls. A payout batch names wallets by their public address only."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/batch.json",
                  "index": 0
                },
                "region": {
                  "startLine": 209,
                  "startColumn": 7
                }
              }
            }
          ],
          "properties": {
            "kind": "input",
            "payment": null
          }
        },
