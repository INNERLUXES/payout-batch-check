          "ruleIndex": 22,
          "level": "error",
          "message": {
            "text": "Payment P-017 pays in DAI, which is not in the list of tokens the batch may pay in (USDC and USDT; --tokens sets another). This is a best practice of this tool, not a rule in the pages it cites. Fix: Pay in a token of the list, or give the tokens your team pays in with --tokens."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/batch.json",
                  "index": 0
